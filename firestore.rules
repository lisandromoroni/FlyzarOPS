rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRecord(data) {
      return data.keys().hasAll(['id', 'dateStr', 'registration', 'route', 'extraUSG', 'totalSavingsUSD'])
        && data.id is string && data.id.size() <= 128
        && data.dateStr is string && data.dateStr.size() <= 32
        && data.registration is string && data.registration.size() <= 32
        && data.route is string && data.route.size() <= 128
        && data.extraUSG is number
        && data.totalSavingsUSD is number
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('flightNumber' in data) || (data.flightNumber is string && data.flightNumber.size() <= 32));
    }

    match /savings_records/{recordId} {
      allow read: if true;
      allow create: if isValidId(recordId) && isValidRecord(request.resource.data);
      allow update: if isValidId(recordId) && isValidRecord(request.resource.data);
      allow delete: if isValidId(recordId);
    }
  }
}
